---
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import { org, pillars, images } from "../data/site.js";
---

<BaseLayout title="About" description="About UGUTU Community Foundation — education as the foundation for an integrated approach to community development across Tanzania.">
  <section class="section section--tight section--paper">
    <div class="container">
      <p class="kicker">About us</p>
      <h1 style="max-width: 20ch;">Education today. Opportunity tomorrow. A stronger community for generations.</h1>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split">
      <div>
        <p>At UGUTU Community Foundation, we believe that education is one of the most powerful foundations for transforming a community.</p>
        <p>Education does more than teach a child how to read and write. It develops knowledge, confidence, skills, creativity, leadership, and the ability to recognise and create opportunities. That is why education sits at the heart of everything we do.</p>
        <p class="mb-0">Our vision is to help create communities where every child has the opportunity to learn, every young person can develop practical skills, and families have the knowledge and resources to build sustainable livelihoods.</p>
      </div>
      <Figure src={images.story} label="A community photograph belongs here" alt="UGUTU Community Foundation community" variant="frame--sand" />
    </div>
  </section>

  <!-- EDUCATION IS OUR FOUNDATION -->
  <section class="section section--sand">
    <div class="container measure-wide">
      <p class="kicker">Education is our foundation</p>
      <h2 style="max-width:24ch;">But education cannot flourish in isolation</h2>
      <p>We believe that a child who receives a quality education can become a catalyst for change within their family and community.</p>
      <p>Children need clean water, good health, safe learning environments, adequate nutrition, and supportive families to reach their potential. Young people also need practical skills and opportunities to turn knowledge into livelihoods.</p>
      <p class="mb-0">This is why UGUTU Community Foundation takes an integrated approach to community development.</p>
    </div>
  </section>

  <!-- SIX PILLARS -->
  <section class="section section--white">
    <div class="container">
      <p class="kicker">Our six pillars</p>
      <h2 style="max-width:22ch;">Six connected pillars of community development</h2>
      <div class="pillar-grid mt-2">
        {pillars.map((p) => (
          <article class="pillar">
            <span class="pillar__icon">{p.icon}</span>
            <h3>{p.title}</h3>
            <p class="pillar__tag">{p.tag}</p>
            <p class="mb-0">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- OUR BELIEF -->
  <section class="section section--green">
    <div class="container">
      <p class="kicker">Our belief</p>
      <h2 style="max-width:26ch;">We don't want to simply provide assistance — we want to help build people who can create solutions</h2>
      <ul class="belief">
        <li>A student who graduates with knowledge and a vision.</li>
        <li>A young person who leaves school with skills and confidence.</li>
        <li>A farmer with knowledge and productive opportunities.</li>
        <li>A family with health, water, food and income.</li>
        <li>A community with the capacity to identify its challenges, develop solutions, and build its own future.</li>
      </ul>
    </div>
  </section>

  <!-- OUR INVITATION -->
  <section class="section section--white">
    <div class="container measure-wide">
      <p class="kicker">Our invitation</p>
      <h2 style="max-width:24ch;">Make education the starting point for lasting change</h2>
      <p>UGUTU Community Foundation invites donors, foundations, businesses, development partners, institutions, volunteers and individuals to join us in making education the starting point for lasting community transformation.</p>
      <p class="mb-0">Because when you educate a person, you don't simply change one life — you create the possibility of changing a family, a community, and generations to come.</p>
      <div class="actions mt-2">
        <a href="/get-involved/" class="btn btn--solid">Get involved</a>
        <a href="/profile/" class="btn btn--ghost">Organization profile</a>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container center">
      <p class="motto">{org.motto}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .measure-wide { max-width: 72ch; }
  .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  @media (max-width: 820px) { .pillar-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .pillar-grid { grid-template-columns: 1fr; } }
  .pillar { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 1.6rem; }
  .pillar__icon { font-size: 1.9rem; display: block; margin-bottom: 0.6rem; }
  .pillar h3 { margin-bottom: 0.2rem; }
  .pillar__tag { color: var(--clay-ink); font-weight: 600; font-size: 0.85rem; margin: 0 0 0.6rem; }
  .pillar p:last-child { color: var(--body); font-size: 0.95rem; }

  .belief { list-style: none; padding: 0; margin: 1.75rem 0 0; display: grid; gap: 0.9rem; max-width: 60ch; }
  .belief li { position: relative; padding-left: 1.6rem; color: #daf0e5; }
  .belief li::before { content: ""; position: absolute; left: 0; top: 0.6rem; width: 8px; height: 8px; border-radius: 50%; background: var(--gold); }

  .motto { font-family: var(--font-display); font-style: italic; font-size: clamp(1.15rem, 1rem + 1vw, 1.6rem); color: var(--green); margin: 0; }
</style>
