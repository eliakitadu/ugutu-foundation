---
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import { org, story, team, fundingSources, images, scope } from "../data/site.js";
---

<BaseLayout title="About" description="Who we are — the story, vision, mission and people behind UGUTU Community Foundation.">
  <section class="section section--tight section--paper">
    <div class="container">
      <p class="kicker">About us</p>
      <h1 style="max-width: 16ch;">A foundation born from a community's need</h1>
      <p class="lead">{org.registration} {org.areaOfOperation}</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split">
      <div>
        <p class="kicker">Our story</p>
        <p>{story}</p>
        <p class="mb-0">{scope}</p>
      </div>
      <Figure src={images.story} label="A founding or community photograph belongs here" alt="UGUTU Community Foundation community" variant="frame--sand" />
    </div>
  </section>

  <!-- VISION + MISSION -->
  <section class="section section--green">
    <div class="container split">
      <div>
        <p class="kicker">Our vision</p>
        <p class="statement" style="color:#fffdf8;">{org.vision}</p>
      </div>
      <div>
        <p class="kicker">Our mission</p>
        <p class="statement" style="color:#fffdf8;">{org.mission}</p>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section section--paper">
    <div class="container">
      <p class="kicker">Our people</p>
      <h2 style="max-width:20ch;">The founding members guiding UGUTU</h2>
      <div class="roster">
        {team.map((m) => (
          <div class="roster__item">
            <p class="roster__name">{m.name}</p>
            <p class="roster__role">{m.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FUNDING -->
  <section class="section section--sand">
    <div class="container split split--reverse">
      <Figure src={images.funding} label="A photograph of an activity or event belongs here" alt="A UGUTU activity or event" />
      <div>
        <p class="kicker">How we are funded</p>
        <h2>Transparent and community-rooted</h2>
        <p>UGUTU is a registered non-governmental organisation, governed by a General Meeting and a Board of Directors, with funds applied solely to advancing our objectives.</p>
        <div class="mt-1">
          {fundingSources.map((f) => <span class="pill">{f}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--green">
    <div class="container center">
      <h2 style="max-width:18ch;margin-inline:auto;">Want to be part of the story?</h2>
      <p class="lead mx-auto" style="margin-bottom:2rem;">Join as a member, volunteer, or supporter and help us reach more children. For the full picture, read our organization profile.</p>
      <div class="actions" style="justify-content:center;">
        <a href="/get-involved/" class="btn btn--solid">Get involved</a>
        <a href="/profile/" class="btn btn--ghost">Organization profile</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .roster {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .roster__item { padding: 1.5rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .roster__name { font-family: var(--font-display); font-size: 1.3rem; color: var(--ink); margin: 0 0 0.2rem; }
  .roster__role { color: var(--clay-ink); font-weight: 600; font-size: 0.9rem; margin: 0; }
  @media (max-width: 760px) { .roster { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .roster { grid-template-columns: 1fr; } }
</style>
