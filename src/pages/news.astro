---
import BaseLayout from "../layouts/BaseLayout.astro";
import { news } from "../data/site.js";
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
---

<BaseLayout title="News" description="Updates, stories and milestones from UGUTU Community Foundation.">
  <section class="section section--tight section--paper">
    <div class="container">
      <p class="kicker">Our news</p>
      <h1>Stories &amp; updates</h1>
      <p class="lead">Follow our journey — milestones, stories from the children we serve, and news from the field.</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      {news.length === 0 ? (
        <div class="empty split split--wide-text">
          <div>
            <p class="kicker">Coming soon</p>
            <h2 style="max-width:16ch;">Our story is just beginning</h2>
            <p class="lead">We haven't posted any updates yet — but there's a lot happening. Soon this page will fill with news from our programs and stories from the children and families we support.</p>
            <div class="actions mt-1">
              <a href="/get-involved/" class="btn btn--solid">Get involved</a>
              <a href="/contact/" class="arrow">Say hello <Fragment set:html={arrow} /></a>
            </div>
          </div>
          <div class="frame frame--sand frame--tall"><span class="frame__label">The first story will appear here</span></div>
        </div>
      ) : (
        <div class="numlist">
          {news.map((post, i) => (
            <article class="numitem">
              <div class="numitem__no">{String(i + 1).padStart(2, "0")}</div>
              <div class="numitem__body">
                {post.date && <p class="kicker">{post.date}</p>}
                <h3>{post.title}</h3>
                <p>{post.excerpt}</p>
                {post.href && <a href={post.href} class="arrow">Read more <Fragment set:html={arrow} /></a>}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .empty { align-items: center; }
</style>
