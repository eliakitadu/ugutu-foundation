---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { org, contacts } from "../data/site.js";
---

<BaseLayout title="Contact" description="Get in touch with UGUTU Community Foundation in Arusha, Tanzania.">
  <section class="section section--tight section--paper">
    <div class="container">
      <p class="kicker">📩 Contact us</p>
      <h1>Let's talk.</h1>
      <p class="lead">Have an idea, want to collaborate, or would like to learn more about our work? We'd love to hear from you.</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container split split--wide-text" style="align-items:start;">
      <div>
        <p class="kicker">The foundation</p>
        <h2 style="font-size:1.6rem;">Reach us in Arusha</h2>
        <dl class="contact-dl">
          <dt>Head office</dt>
          <dd>{org.address.street}<br />{org.address.ward}<br />{org.address.region}<br />{org.address.poBox}</dd>
          <dt>Phone</dt>
          <dd>{contacts.map((c) => <span class="contact-phone"><a href={`tel:${c.tel}`}>{c.phone}</a> · {c.name}</span>)}</dd>
          <dt>Email</dt>
          <dd><a href={`mailto:${org.email}`}>{org.email}</a></dd>
          {org.social.instagram && (
            <>
              <dt>Instagram</dt>
              <dd><a href={`https://instagram.com/${org.social.instagram}`} target="_blank" rel="noopener">@{org.social.instagram}</a></dd>
            </>
          )}
        </dl>
      </div>
      <div>
        <ContactForm subject="Website enquiry" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-dl dt { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.72rem; font-weight: 700; color: var(--clay-ink); margin-top: 1.25rem; }
  .contact-dl dd { margin: 0.35rem 0 0; line-height: 1.7; color: var(--body); }
  .contact-phone { display: block; }
</style>
