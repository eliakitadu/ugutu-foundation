---
import BaseLayout from "../layouts/BaseLayout.astro";
import { programs, cycle } from "../data/site.js";
---

<BaseLayout title="Our Work" description="UGUTU Community Foundation's programs, projects and activities — education, water, healthcare, agriculture, livestock, economic empowerment, youth and community development.">
  <section class="section section--tight section--paper">
    <div class="container">
      <p class="kicker">Our programs, projects &amp; activities</p>
      <h1 style="max-width: 20ch;">Creating opportunities. Building skills. Transforming communities.</h1>
      <p class="lead">We focus on education as the foundation, while investing in the water, health, livelihoods, agriculture, livestock and economic opportunities that allow people to learn, grow, become productive and build better lives.</p>
    </div>
  </section>

  {programs.map((p, i) => (
    <section class={`section ${i % 2 === 0 ? "section--white" : "section--sand"}`} id={p.slug}>
      <div class="container">
        <div class="prog-head">
          <span class="prog-icon">{p.icon}</span>
          <div>
            <p class="prog-num">Program {String(i + 1).padStart(2, "0")}</p>
            <h2>{p.title}</h2>
            <p class="prog-sub">{p.subtitle}</p>
          </div>
        </div>
        <p class="prog-intro measure-wide">{p.intro}</p>
        <div class="prog-cols">
          <div>
            <p class="prog-label">Activities include</p>
            <ul class="prog-acts">{p.activities.map((a) => <li>{a}</li>)}</ul>
          </div>
          <div class="prog-goal">
            <p class="prog-label">Our goal</p>
            <p class="mb-0">{p.goal}</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- INTEGRATED APPROACH -->
  <section class="section section--green">
    <div class="container">
      <p class="kicker">Our integrated approach</p>
      <h2 style="max-width:22ch;">Our programs are connected</h2>
      <p class="lead">Education creates knowledge. Water creates the foundation for health and production. Healthcare protects people's ability to learn and work. Agriculture and livestock create food and productive assets. Skills and entrepreneurship create economic opportunity — which helps families invest in education and build better futures.</p>
      <div class="cycle">
        {cycle.map((step, i) => (
          <>
            <span class="cycle__step">{step}</span>
            {i < cycle.length - 1 && <span class="cycle__arrow">→</span>}
          </>
        ))}
      </div>
      <p class="mb-0" style="color:#b9cabf;max-width:60ch;">We don't simply want to deliver projects. We want to build people, strengthen communities, and create opportunities that continue from one generation to the next.</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container center">
      <h2 style="max-width:20ch;margin-inline:auto;">Be part of the work</h2>
      <p class="lead mx-auto" style="margin-bottom:2rem;">Give, volunteer, partner or sponsor a project — every kind of help reaches a community.</p>
      <div class="actions" style="justify-content:center;">
        <a href="/get-involved/#donate" class="btn btn--solid">Donate now</a>
        <a href="/get-involved/" class="btn btn--ghost">Get involved</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .measure-wide { max-width: 74ch; }
  .prog-head { display: flex; align-items: flex-start; gap: 1.1rem; }
  .prog-icon { font-size: 2.4rem; line-height: 1; flex: none; }
  .prog-num { text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; font-weight: 700; color: var(--clay-ink); margin: 0 0 0.2rem; }
  .prog-head h2 { margin-bottom: 0.15rem; }
  .prog-sub { color: var(--muted); font-style: italic; margin: 0; }
  .prog-intro { margin-top: 1.3rem; }
  .prog-cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(1.5rem, 1rem + 3vw, 3.5rem); margin-top: 1.5rem; align-items: start; }
  @media (max-width: 760px) { .prog-cols { grid-template-columns: 1fr; gap: 1.5rem; } }
  .prog-label { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.7rem; font-weight: 700; color: var(--green); margin: 0 0 0.7rem; }
  .prog-acts { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 2rem; }
  @media (max-width: 520px) { .prog-acts { columns: 1; } }
  .prog-acts li { position: relative; padding-left: 1.1rem; margin-bottom: 0.5rem; break-inside: avoid; font-size: 0.95rem; }
  .prog-acts li::before { content: ""; position: absolute; left: 0; top: 0.55rem; width: 6px; height: 6px; border-radius: 50%; background: var(--clay); }
  .prog-goal { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 1.4rem; }
  .section--sand .prog-goal { background: var(--white); }

  .cycle { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin: 2rem 0; }
  .cycle__step { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #fffdf8; padding: 0.5rem 1rem; border-radius: 999px; font-weight: 600; font-size: 0.9rem; }
  .cycle__arrow { color: var(--gold); font-weight: 700; }
</style>
