---
import BaseLayout from "../layouts/BaseLayout.astro";
import { gallery } from "../data/site.js";
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
---

<BaseLayout title="Gallery" description="Photographs from UGUTU Community Foundation — our schools, children and community in Arusha and Simanjiro.">
  <section class="section section--tight section--paper">
    <div class="container">
      <p class="kicker">Gallery</p>
      <h1>Moments from our centers</h1>
      <p class="lead">Photographs from our learning centers, the children we support, and the communities we serve in Usa River and Simanjiro.</p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      {gallery.length === 0 ? (
        <div class="empty split split--wide-text">
          <div>
            <p class="kicker">Coming soon</p>
            <h2 style="max-width:16ch;">Photographs on their way</h2>
            <p class="lead">We're gathering good photos of our schools, children and community. This gallery will fill up soon — check back, or follow us on Instagram in the meantime.</p>
            <div class="actions mt-1">
              <a href="https://instagram.com/jowindaycare" target="_blank" rel="noopener" class="btn btn--solid">Follow @jowindaycare</a>
              <a href="/get-involved/" class="arrow">Get involved <Fragment set:html={arrow} /></a>
            </div>
          </div>
          <div class="frame frame--sand frame--tall"><span class="frame__label">The first photographs will appear here</span></div>
        </div>
      ) : (
        <div class="gallery-grid">
          {gallery.map((g) => (
            <figure class="gallery-item">
              <button class="gallery-btn" type="button" data-src={g.src} data-caption={g.caption || ""} aria-label={g.alt || "View photo"}>
                <img src={g.src} alt={g.alt || ""} loading="lazy" decoding="async" />
              </button>
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox__close" id="lb-close" aria-label="Close">&times;</button>
    <button class="lightbox__nav lightbox__prev" id="lb-prev" aria-label="Previous">&#8249;</button>
    <figure class="lightbox__fig">
      <img id="lb-img" src="" alt="" />
      <figcaption id="lb-cap"></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__next" id="lb-next" aria-label="Next">&#8250;</button>
  </div>

  <script>
    const lb = document.getElementById("lightbox");
    if (lb) {
      const img = document.getElementById("lb-img");
      const cap = document.getElementById("lb-cap");
      const btns = Array.from(document.querySelectorAll(".gallery-btn"));
      let idx = 0;
      const show = (i) => {
        idx = (i + btns.length) % btns.length;
        const b = btns[idx];
        img.src = b.dataset.src; img.alt = b.getAttribute("aria-label") || "";
        cap.textContent = b.dataset.caption || "";
      };
      const open = (i) => { show(i); lb.hidden = false; document.body.style.overflow = "hidden"; };
      const close = () => { lb.hidden = true; document.body.style.overflow = ""; };
      btns.forEach((b, i) => b.addEventListener("click", () => open(i)));
      document.getElementById("lb-close").addEventListener("click", close);
      document.getElementById("lb-next").addEventListener("click", () => show(idx + 1));
      document.getElementById("lb-prev").addEventListener("click", () => show(idx - 1));
      lb.addEventListener("click", (e) => { if (e.target === lb) close(); });
      document.addEventListener("keydown", (e) => {
        if (lb.hidden) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowRight") show(idx + 1);
        if (e.key === "ArrowLeft") show(idx - 1);
      });
    }
  </script>
</BaseLayout>

<style>
  .empty { align-items: center; }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.6rem, 0.3rem + 1vw, 1rem);
  }
  @media (max-width: 780px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .gallery-grid { grid-template-columns: 1fr; } }
  .gallery-item { margin: 0; }
  .gallery-btn {
    display: block; width: 100%; padding: 0; border: none; cursor: pointer;
    border-radius: 6px; overflow: hidden; background: none; box-shadow: var(--shadow-sm);
  }
  .gallery-btn img {
    width: 100%; aspect-ratio: 1 / 1; object-fit: cover; display: block;
    transition: transform 0.4s ease;
  }
  .gallery-btn:hover img, .gallery-btn:focus-visible img { transform: scale(1.06); }
  .gallery-item figcaption { font-size: 0.8rem; color: var(--muted); margin-top: 0.5rem; font-style: italic; }

  /* Lightbox */
  .lightbox {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(12, 26, 20, 0.92);
    display: grid; grid-template-columns: auto 1fr auto; align-items: center;
    padding: clamp(1rem, 4vw, 3rem);
  }
  .lightbox[hidden] { display: none; }
  .lightbox__fig { margin: 0; text-align: center; max-height: 90vh; }
  .lightbox__fig img { max-width: 100%; max-height: 82vh; border-radius: 8px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .lightbox__fig figcaption { color: #e6efe8; margin-top: 0.9rem; font-style: italic; font-size: 0.95rem; }
  .lightbox__close {
    position: absolute; top: 1rem; right: 1.25rem;
    background: none; border: none; color: #fff; font-size: 2.4rem; line-height: 1; cursor: pointer;
  }
  .lightbox__nav {
    background: rgba(255,255,255,0.12); border: none; color: #fff;
    width: 52px; height: 52px; border-radius: 50%; font-size: 2rem; line-height: 1; cursor: pointer;
    display: grid; place-items: center; transition: background 0.15s ease;
  }
  .lightbox__nav:hover { background: rgba(255,255,255,0.25); }
  @media (max-width: 640px) {
    .lightbox { grid-template-columns: 1fr; }
    .lightbox__nav { position: absolute; top: 50%; transform: translateY(-50%); }
    .lightbox__prev { left: 0.5rem; }
    .lightbox__next { right: 0.5rem; }
  }
</style>
