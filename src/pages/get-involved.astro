---
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import ContactForm from "../components/ContactForm.astro";
import Icon from "../components/Icon.astro";
import { involve, donationTiers, images, org } from "../data/site.js";
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>';
const amountOptions = donationTiers.map((t) => `${t.amount} ${t.period}`);
---

<BaseLayout title="Get Involved" description="Support UGUTU Community Foundation — donate, volunteer, partner, or sponsor a project.">
  <section class="section section--tight section--paper">
    <div class="container">
      <p class="kicker">Join us</p>
      <h1 style="max-width: 20ch;">Be part of building a better future</h1>
      <p class="lead">Real change happens when people come together. Whether you want to support a child's education, help provide clean water, strengthen healthcare, or empower young people — there is a place for you in the UGUTU Community Foundation family.</p>
    </div>
  </section>

  <!-- FIVE PATHS -->
  <section class="section section--tight section--white">
    <div class="container">
      <div class="features">
        {involve.map((it) => (
          <article class="feature">
            <span class="icon-token"><Icon name={it.icon} /></span>
            <h3>{it.title}</h3>
            <p class="feature__tag">{it.tagline}</p>
            <p>{it.blurb}</p>
            <a href={it.href} class="arrow">{it.cta} <Fragment set:html={arrow} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DONATE -->
  <section class="section section--sand" id="donate">
    <div class="container">
      <p class="kicker">Donate</p>
      <h2 style="max-width:22ch;">Give a gift that creates opportunity</h2>
      <p class="lead measure">Your contribution helps turn community needs into lasting solutions — from a child's school place to clean water for an entire community. Give securely online with PayPal, or choose an amount below and send us a message.</p>

      <!-- PAYPAL -->
      <div class="paypal">
        <div class="paypal__text">
          <p class="kicker">Give online</p>
          <h3>Donate securely with PayPal</h3>
          <p>Make a one-off or recurring gift in seconds — using your PayPal balance or any debit or credit card, no account required. Scan the code with your phone camera, or tap the button.</p>
          <a href={org.paypal} class="btn btn--green" target="_blank" rel="noopener noreferrer">Donate with PayPal</a>
        </div>
        <figure class="paypal__qr">
          <img src={org.paypalQr} width="220" height="220" alt="QR code linking to the UGUTU Community Foundation PayPal donation page" loading="lazy" />
          <figcaption>Scan to donate</figcaption>
        </figure>
      </div>

      <div class="tiers">
        {donationTiers.map((t) => (
          <article class="tier">
            <div class="tier__amt">{t.amount} <span>{t.period}</span></div>
            <p class="mb-0">{t.text}</p>
            <a href="#donate-form" class="btn btn--green tier__btn" data-give={`${t.amount} ${t.period}`}>Give {t.amount}</a>
          </article>
        ))}
      </div>
      <p class="tiers-note">Amounts are examples — give whatever you can, monthly or one-off. Every contribution matters.</p>

      <div class="split split--wide-text mt-2" id="donate-form" style="align-items:start;">
        <div>
          <h3>Ready to give?</h3>
          <p>Send us a message and we'll reply with our giving details and answer any questions — including monthly giving, sponsoring a child, or supporting a specific project.</p>
        </div>
        <ContactForm subject="Donation enquiry" amounts={amountOptions} messageRequired={false} />
      </div>
    </div>
  </section>

  <!-- VOLUNTEER -->
  <section class="section section--white" id="volunteer">
    <div class="container split split--wide-text" style="align-items:start;">
      <div>
        <p class="kicker">Volunteer</p>
        <h2>Give your time. Share your skills. Inspire change.</h2>
        <p>Join us with your knowledge, experience, talents or time and become part of our work on the ground — teaching, mentoring, and supporting our learning centers in Usa River and Simanjiro.</p>
        <p>Tell us a little about yourself and how you'd like to help, and we'll be in touch.</p>
      </div>
      <ContactForm
        subject="Volunteer enquiry"
        select={{ label: "How would you like to help?", name: "interest", options: ["Teaching & mentoring", "On-the-ground support at our centers", "Skills / professional support", "Fundraising & awareness", "Other"] }}
      />
    </div>
  </section>

  <!-- PARTNER -->
  <section class="section section--sand" id="partner">
    <div class="container split">
      <div>
        <p class="kicker">Partner with us</p>
        <h2>Let's build something that lasts</h2>
        <p>Partner with us as a company, foundation, institution, organisation or individual to create sustainable community impact — through grants, projects, construction and long-term collaboration.</p>
        <a href="/contact/" class="arrow mt-1">Start a partnership <Fragment set:html={arrow} /></a>
      </div>
      <Figure src={images.partner} label="A photograph of a partnership belongs here" alt="A UGUTU partnership" variant="frame--sand" />
    </div>
  </section>

  <!-- SPONSOR A PROJECT -->
  <section class="section section--white" id="sponsor">
    <div class="container split split--wide-text" style="align-items:start;">
      <div>
        <p class="kicker">Sponsor a project</p>
        <h2>Choose a project. Create lasting impact.</h2>
        <p>Support a specific initiative in education, water, healthcare, agriculture, livestock, youth development or economic empowerment — and see your gift build something that continues to create value for years.</p>
        <p>Pick an area below and send us a note — we'll share the current projects and what your support can achieve.</p>
      </div>
      <ContactForm
        subject="Project sponsorship enquiry"
        select={{ label: "Which area would you like to support?", name: "project", options: ["Education", "Clean water", "Healthcare", "Agriculture", "Livestock", "Economic empowerment", "Youth development", "Where the need is greatest"] }}
        messageRequired={false}
      />
    </div>
  </section>

  <!-- EVERY CONTRIBUTION -->
  <section class="section section--green">
    <div class="container center">
      <p class="kicker" style="justify-content:center;">Every contribution matters</p>
      <h2 style="max-width:24ch;margin-inline:auto;">You don't have to change the whole world</h2>
      <p class="lead mx-auto">You can help change one classroom. One student's future. One family's livelihood. One community's opportunity. Together, those changes become something much bigger.</p>
      <div class="actions mt-2" style="justify-content:center;">
        <a href="#donate" class="btn btn--solid">Donate now</a>
        <a href="/contact/" class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .feature__emoji { font-size: 1.8rem; display: block; margin-bottom: 0.7rem; }
  .feature__tag { color: var(--clay-ink); font-weight: 600; font-size: 0.9rem; }

  .paypal {
    display: grid; grid-template-columns: 1fr auto; gap: clamp(1.5rem, 1rem + 3vw, 3rem); align-items: center;
    background: var(--white); border: 1px solid var(--line); border-radius: 12px;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); margin-top: 2rem;
  }
  .paypal h3 { margin: 0.2rem 0 0.6rem; }
  .paypal__text p { color: var(--body); max-width: 46ch; }
  .paypal__text .btn { margin-top: 0.4rem; }
  .paypal__qr { margin: 0; text-align: center; }
  .paypal__qr img { display: block; width: 200px; height: 200px; border: 1px solid var(--line); border-radius: 10px; padding: 0.5rem; background: #fff; }
  .paypal__qr figcaption { font-size: 0.82rem; color: var(--muted); margin-top: 0.5rem; font-weight: 600; letter-spacing: 0.02em; }
  @media (max-width: 640px) {
    .paypal { grid-template-columns: 1fr; justify-items: start; }
    .paypal__qr { justify-self: center; }
  }

  .tiers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem; }
  @media (max-width: 820px) { .tiers { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 460px) { .tiers { grid-template-columns: 1fr; } }
  .tier { background: var(--white); border: 1px solid var(--line); border-radius: 10px; padding: 1.4rem; display: flex; flex-direction: column; }
  .tier__amt { font-family: var(--font-display); font-size: 1.8rem; color: var(--green); line-height: 1; margin-bottom: 0.6rem; }
  .tier__amt span { font-family: var(--font-text); font-size: 0.8rem; color: var(--muted); font-weight: 600; }
  .tier p { color: var(--body); font-size: 0.95rem; }
  .tier__btn { margin-top: auto; align-self: flex-start; }
  .tiers-note { font-size: 0.88rem; color: var(--muted); margin-top: 1rem; font-style: italic; }
</style>
