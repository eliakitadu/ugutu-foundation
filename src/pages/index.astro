---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { org, programs, involve, story } from "../data/site.js";
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <span class="hero__badge"><Icon name="leaf" size={16} /> Registered NGO in Arusha, Tanzania</span>
        <h1>Education is the way out of poverty for Tanzania's children.</h1>
        <p class="lead">{org.tagline}</p>
        <div class="hero__actions">
          <a href="/get-involved/#donate" class="btn btn--primary">Donate now</a>
          <a href="/about/" class="btn btn--outline">Discover UGUTU</a>
        </div>
        <ul class="hero__trust">
          <li><Icon name="book" size={18} /> Quality education</li>
          <li><Icon name="hands" size={18} /> Community-rooted</li>
          <li><Icon name="shield" size={18} /> Rights for all</li>
        </ul>
      </div>
      <div class="hero__media">
        <div class="ph hero__ph"><span>Add a hero photo of the children / school</span></div>
        <div class="hero__float">
          <strong>4</strong>
          <span>core programs<br />changing lives</span>
        </div>
      </div>
    </div>
  </section>

  <!-- MISSION STRIP -->
  <section class="section section--white">
    <div class="container center">
      <p class="eyebrow" style="justify-content:center;">Why we exist</p>
      <h2 class="mx-auto" style="max-width: 24ch;">Making quality education reachable for every child</h2>
      <p class="lead mx-auto">{story}</p>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section section--cream-2">
    <div class="container">
      <div class="center">
        <p class="eyebrow" style="justify-content:center;">What we do</p>
        <h2>Our programs</h2>
      </div>
      <div class="grid grid--4 mt-2">
        {programs.map((p) => (
          <article class="card">
            <div class="card__icon"><Icon name={p.icon} /></div>
            <h3>{p.title}</h3>
            <p class="mb-0">{p.summary}</p>
          </article>
        ))}
      </div>
      <div class="center mt-2">
        <a href="/programs/" class="btn btn--green">Explore our programs</a>
      </div>
    </div>
  </section>

  <!-- IMPACT / SPLIT -->
  <section class="section section--white">
    <div class="container split">
      <div class="split__media ph"><span>Add a photo from the field</span></div>
      <div>
        <p class="eyebrow">The children we serve</p>
        <h2>For the vulnerable, voiceless and underprivileged</h2>
        <p>We work for the women, youth and children who are too often left behind — orphans and vulnerable children whose families cannot afford the cost of school.</p>
        <p>By keeping children in the classroom and equipping their communities with real skills, we break the cycle that pushes them toward child labour and drugs.</p>
        <a href="/about/" class="btn btn--outline">Read our story</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section section--green">
    <div class="container">
      <div class="grid grid--3">
        <div class="stat"><div class="stat__num">4</div><div class="stat__label">Core programs</div></div>
        <div class="stat"><div class="stat__num">National</div><div class="stat__label">Reach across Tanzania</div></div>
        <div class="stat"><div class="stat__num">Arusha</div><div class="stat__label">Where we are based</div></div>
      </div>
    </div>
  </section>

  <!-- HOW TO HELP -->
  <section class="section section--cream">
    <div class="container">
      <div class="center">
        <p class="eyebrow" style="justify-content:center;">Get involved</p>
        <h2>How you can help</h2>
        <p class="lead mx-auto">We need your support. You can stand with UGUTU as a donor, a volunteer, or a partner.</p>
      </div>
      <div class="grid grid--3 mt-2">
        {involve.map((i) => (
          <article class="card">
            <div class="card__icon"><Icon name={i.icon} /></div>
            <h3>{i.title}</h3>
            <p>{i.blurb}</p>
            <a href={i.href} class="btn btn--green">{i.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--green">
    <div class="container center">
      <h2>Join hands with UGUTU</h2>
      <p class="lead mx-auto">Every child deserves the chance to learn. Reach out to partner, volunteer or give.</p>
      <div class="hero__actions" style="justify-content:center;">
        <a href="/get-involved/#donate" class="btn btn--primary">Donate now</a>
        <a href="/contact/" class="btn btn--outline">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(1100px 460px at 82% -12%, rgba(244,160,28,0.16), transparent 60%),
      radial-gradient(800px 400px at 0% 110%, rgba(15,123,82,0.10), transparent 60%),
      var(--cream);
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.75rem, 1rem + 4vw, 4rem);
    align-items: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--green-700);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.25rem;
  }
  .hero h1 { margin-bottom: 0.6rem; }
  .hero__actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 1.6rem; }
  .hero__trust {
    list-style: none; padding: 0; margin: 2rem 0 0;
    display: flex; flex-wrap: wrap; gap: 1.25rem;
    color: var(--muted); font-weight: 500; font-size: 0.92rem;
  }
  .hero__trust li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .hero__trust svg { color: var(--green-600); }

  .hero__media { position: relative; }
  .hero__ph { min-height: clamp(280px, 42vw, 420px); border-radius: var(--radius-lg); }
  .hero__float {
    position: absolute;
    left: -12px; bottom: -18px;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1rem 1.25rem;
    display: flex; align-items: center; gap: 0.75rem;
    border: 1px solid var(--line);
  }
  .hero__float strong {
    font-family: var(--font-head);
    font-size: 2.2rem;
    color: var(--green-700);
    line-height: 1;
  }
  .hero__float span { font-size: 0.85rem; color: var(--muted); line-height: 1.25; }

  @media (max-width: 820px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__float { left: auto; right: 12px; }
  }
  @media (max-width: 400px) {
    .hero__float { display: none; }
  }
</style>
