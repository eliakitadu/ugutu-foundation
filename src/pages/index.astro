---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { org, programs, involve, story } from "../data/site.js";
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow">UGUTU Community Foundation</p>
        <h1>Education is the way out of poverty for Tanzania's children.</h1>
        <p class="lead">{org.tagline}</p>
        <div class="hero__actions">
          <a href="/get-involved/#donate" class="btn btn--primary">Donate now</a>
          <a href="/about/" class="btn btn--outline">Discover UGUTU</a>
        </div>
      </div>
      <div class="hero__media ph"><span>Add a hero photo of the children / school</span></div>
    </div>
  </section>

  <!-- MISSION STRIP -->
  <section class="section section--white">
    <div class="container center">
      <p class="eyebrow">Why we exist</p>
      <h2 class="mx-auto" style="max-width: 22ch;">Making quality education reachable for every child</h2>
      <p class="lead mx-auto">{story}</p>
    </div>
  </section>

  <!-- PROGRAMS -->
  <section class="section section--cream">
    <div class="container">
      <div class="center">
        <p class="eyebrow">What we do</p>
        <h2>Our programs</h2>
      </div>
      <div class="grid grid--4 mt-2">
        {programs.map((p) => (
          <article class="card">
            <div class="card__icon"><Icon name={p.icon} /></div>
            <h3>{p.title}</h3>
            <p class="mb-0">{p.summary}</p>
          </article>
        ))}
      </div>
      <div class="center mt-2">
        <a href="/programs/" class="btn btn--green">Explore our programs</a>
      </div>
    </div>
  </section>

  <!-- IMPACT / SPLIT -->
  <section class="section section--white">
    <div class="container split">
      <div class="split__media ph"><span>Add a photo from the field</span></div>
      <div>
        <p class="eyebrow">The children we serve</p>
        <h2>For the vulnerable, voiceless and underprivileged</h2>
        <p>We work for the women, youth and children who are too often left behind — orphans and vulnerable children whose families cannot afford the cost of school.</p>
        <p>By keeping children in the classroom and equipping their communities with real skills, we break the cycle that pushes them toward child labour and drugs.</p>
        <a href="/about/" class="btn btn--outline">Read our story</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section section--green">
    <div class="container">
      <div class="grid grid--3">
        <div class="stat"><div class="stat__num">4</div><div class="stat__label">Core programs</div></div>
        <div class="stat"><div class="stat__num">National</div><div class="stat__label">Reach across Tanzania</div></div>
        <div class="stat"><div class="stat__num">Arusha</div><div class="stat__label">Where we are based</div></div>
      </div>
    </div>
  </section>

  <!-- HOW TO HELP -->
  <section class="section section--cream">
    <div class="container">
      <div class="center">
        <p class="eyebrow">Get involved</p>
        <h2>How you can help</h2>
        <p class="lead mx-auto">We need your support. You can stand with UGUTU as a donor, a volunteer, or a partner.</p>
      </div>
      <div class="grid grid--3 mt-2">
        {involve.map((i) => (
          <article class="card">
            <div class="card__icon"><Icon name={i.title === "Donate" ? "heart" : i.title === "Volunteer" ? "hands" : "spark"} /></div>
            <h3>{i.title}</h3>
            <p>{i.blurb}</p>
            <a href={i.href} class="btn btn--green">{i.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--white">
    <div class="container center">
      <h2>Join hands with UGUTU</h2>
      <p class="lead mx-auto">Every child deserves the chance to learn. Reach out to partner, volunteer or give.</p>
      <div class="hero__actions center" style="justify-content:center;">
        <a href="/contact/" class="btn btn--primary">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(1200px 400px at 80% -10%, rgba(244,160,28,0.12), transparent 60%),
      var(--cream);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .hero__media { min-height: 360px; }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  @media (max-width: 820px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__media { min-height: 240px; }
  }
</style>
