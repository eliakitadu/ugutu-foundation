---
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import { programs } from "../data/site.js";
---

<BaseLayout title="Programs" description="The four core programs of UGUTU Community Foundation: quality education, entrepreneurship, environment conservation, and rights awareness.">
  <section class="section section--tight section--paper">
    <div class="container">
      <p class="kicker">What we do</p>
      <h1 style="max-width: 18ch;">Our programs</h1>
      <p class="lead">Four connected areas of work, drawn from the objectives at the heart of our foundation.</p>
    </div>
  </section>

  {programs.map((p, i) => (
    <section class={`section ${i % 2 === 0 ? "section--white" : "section--sand"}`} id={p.slug}>
      <div class={`container split ${i % 2 === 1 ? "split--reverse" : ""}`}>
        <div>
          <p class="kicker">Program {String(i + 1).padStart(2, "0")}</p>
          <h2>{p.title}</h2>
          <p class="lead" style="font-size:1.12rem;">{p.summary}</p>
          <p class="mb-0">{p.body}</p>
        </div>
        <Figure src="" label={`A photograph for “${p.title}” belongs here`} alt={p.title} variant={i % 2 === 1 ? "frame--sand" : ""} />
      </div>
    </section>
  ))}

  <section class="section section--green">
    <div class="container center">
      <h2 style="max-width:20ch;margin-inline:auto;">Help us grow these programs</h2>
      <p class="lead mx-auto" style="margin-bottom:2rem;">Your support turns these objectives into real classrooms, skills and futures.</p>
      <a href="/get-involved/#donate" class="btn btn--solid">Support a program</a>
    </div>
  </section>
</BaseLayout>
