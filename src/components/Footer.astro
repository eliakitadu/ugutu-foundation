---
import { org, nav } from "../data/site.js";
const year = new Date().getFullYear();
---

<footer class="site-footer section--green">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        {org.logo
          ? <img src={org.logo} alt={org.name} class="footer-logo" />
          : <p class="footer-word">{org.shortName}</p>}
        <p class="footer-tagline">{org.tagline}</p>
        <a href="/get-involved/#donate" class="btn btn--solid mt-1">Support our work</a>
      </div>

      <div class="footer-cols">
        <div>
          <h4>Explore</h4>
          <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        </div>
        <div>
          <h4>Visit</h4>
          <address>
            {org.address.street}<br />
            {org.address.ward}<br />
            {org.address.region}<br />
            {org.address.poBox}
          </address>
          <p class="footer-email"><a href={`mailto:${org.email}`}>{org.email}</a></p>
          {org.social.instagram && (
            <p class="footer-social">
              <a href={`https://instagram.com/${org.social.instagram}`} target="_blank" rel="noopener">Instagram · @{org.social.instagram}</a>
            </p>
          )}
        </div>
      </div>
    </div>

    <hr class="footer-rule" />
    <div class="footer-bar">
      <p>© {year} {org.name}</p>
      <p class="footer-reg">{org.registration}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(3rem, 2rem + 4vw, 5rem); }
  .footer-top { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 1rem + 4vw, 5rem); }
  @media (max-width: 780px) { .footer-top { grid-template-columns: 1fr; gap: 2.5rem; } }

  .footer-word { font-family: var(--font-display); font-size: 2.6rem; color: #fffdf8; margin: 0 0 0.6rem; letter-spacing: 0.02em; }
  .footer-logo { height: 60px; width: auto; margin-bottom: 0.8rem; }
  .footer-social { margin-top: 0.5rem; }
  .footer-tagline { color: #c3d4c9; max-width: 34ch; margin: 0 0 0.5rem; }

  .footer-cols { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem; }
  @media (max-width: 460px) { .footer-cols { grid-template-columns: 1fr; } }
  h4 { color: #fffdf8; font-family: var(--font-text); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.18em; margin-bottom: 1rem; font-weight: 700; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.55rem; }
  a { color: #cbdccf; }
  a:hover { color: var(--gold); text-decoration: none; }
  address { font-style: normal; line-height: 1.75; color: #c3d4c9; font-size: 0.95rem; }
  .footer-email { margin-top: 0.8rem; }

  .footer-rule { border: none; border-top: 1px solid rgba(255,255,255,0.16); margin: clamp(2rem, 4vw, 3rem) 0 1.4rem; }
  .footer-bar { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .footer-bar p { margin: 0; font-size: 0.83rem; color: #98ab9f; }
  .footer-reg { max-width: 48ch; text-align: right; }
  @media (max-width: 620px) { .footer-reg { text-align: left; } }
</style>
